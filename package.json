{
  "name": "ipl-trader",
  "version": "1.0.0",
  "description": "Node + Express + Effect TypeScript starter",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:all": "pnpm dev:stack",
    "dev:stack": "concurrently -n backend,web -c blue,green \"pnpm dev\" \"pnpm web:dev\"",
    "web:dev": "pnpm --filter @ipl-trader/web dev",
    "web:build": "pnpm --filter @ipl-trader/web build",
    "web:typecheck": "pnpm --filter @ipl-trader/web typecheck",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "model:data:prepare": "tsx src/model-data/prepare-datasets.ts",
    "model:data:styles:import": "tsx src/model-data/import-free-player-styles.ts",
    "model:data:styles": "tsx src/model-data/prepare-player-styles.ts",
    "model:data:derive": "tsx src/model-data/derive-features.ts",
    "model:data:fixtures": "tsx src/model-data/fetch-upcoming-fixtures.ts",
    "model:data:results-current": "tsx src/model-data/fetch-completed-results.ts",
    "model:data:squads-current": "tsx src/model-data/refresh-current-squads.ts",
    "model:data:player-stats-current": "tsx src/model-data/refresh-current-player-stats.ts",
    "model:data:elo-current": "tsx src/model-data/refresh-current-elo.ts",
    "model:data:matrix": "tsx src/model-data/build-model-matrices.ts",
    "model:data:ball-state": "python3 model/build_ball_state_matrix.py",
    "model:train:ball-state": "python3 model/train_ball_state.py",
    "model:train:ball-state-live": "python3 model/train_ball_state.py --feature-mode live_compatible --output-dir model/experiments/ball-state/live-compatible-artifacts",
    "model:train:ball-state-live-trajectory": "python3 model/train_ball_state.py --feature-mode live_compatible_trajectory --output-dir model/experiments/ball-state/live-compatible-trajectory-artifacts",
    "model:train:ball-state-live-selected-trajectory": "python3 model/train_ball_state.py --feature-mode live_compatible_selected_trajectory --output-dir model/experiments/ball-state/live-compatible-selected-trajectory-artifacts",
    "model:select:ball-state-live": "python3 model/select_ball_state_live_candidate.py --output model/ball_state_live_candidate_selection.json",
    "model:shadow:ball-state-live": "python3 model/shadow_score_ball_state_live.py --candidate-manifest model/ball_state_live_candidate_selection.json",
    "model:capture:ball-events": "python3 model/capture_live_ball_events.py",
    "model:scrape:espn-ball-events": "python3 model/scrape_espncricinfo_ball_events.py",
    "model:events:to-snapshots": "python3 model/build_live_event_snapshots.py",
    "model:events:to-live-payload": "python3 model/build_live_payload_from_events.py",
    "model:live:no-paid": "python3 model/run_no_paid_ball_state_live.py",
    "model:tune:ball-state-live": "python3 model/tune_ball_state_live_candidates.py",
    "model:validate:ball-state-live": "python3 model/validate_ball_state_live_parity.py",
    "model:test:ball-state-live": "python3 model/test_ball_state_match_win_regressions.py",
    "model:train:pretoss": "python3 model/train_baselines.py --matrix pre_toss",
    "model:train:posttoss": "python3 model/train_baselines.py --matrix post_toss",
    "model:ensemble:pretoss": "python3 model/build_catboost_ensemble.py --matrix pre_toss",
    "model:ensemble:posttoss": "python3 model/build_catboost_ensemble.py --matrix post_toss",
    "model:importance:pretoss": "python3 model/export_catboost_importance.py --matrix pre_toss --feature-mode full",
    "model:importance:posttoss": "python3 model/export_catboost_importance.py --matrix post_toss --feature-mode full",
    "model:prune:pretoss": "python3 model/build_pruned_allowlists.py --matrix pre_toss --feature-mode full",
    "model:prune:posttoss": "python3 model/build_pruned_allowlists.py --matrix post_toss --feature-mode full",
    "model:stack:pretoss": "python3 model/build_stacked_ensemble.py --matrix pre_toss --source model/artifacts/pre_toss/full:catboost_tuned:full_cat --source model/artifacts/pre_toss/delta:catboost_tuned:delta_cat --source model/artifacts_pruned/top60/pre_toss/full:catboost_tuned:top60_cat",
    "model:fit:final": "python3 model/fit_final_catboost_ensemble.py",
    "model:predict": "python3 model/predict_fixture.py",
    "model:sensitivity:toss": "python3 model/check_toss_sensitivity.py",
    "model:promote:catboost-single": "python3 model/promote_catboost_single_component.py",
    "model:promote:xgboost": "python3 model/promote_xgboost_experiment.py",
    "model:experiment": "python3 model/run_experiment_suite.py",
    "model:experiment:squad-info": "python3 model/build_squad_info_experiment.py",
    "model:eligibility:match": "python3 model/check_match_model_promotion_eligibility.py",
    "model:backtest": "python3 model/backtest_predictions.py",
    "model:daily-refresh": "python3 model/run_daily_refresh.py",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.20.0",
  "type": "module",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@polymarket/clob-client-v2": "1.0.6",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.21.0",
    "express": "^5.2.1",
    "pg": "^8.20.0",
    "viem": "^2.48.11",
    "winston": "^3.19.0"
  }
}
