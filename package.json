{
  "name": "ipl-trader",
  "version": "1.0.0",
  "description": "Node + Express + Effect TypeScript starter",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
