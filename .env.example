PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgresql://localhost:5432/ipl_trader_development
# Optional: protects /observer/* JSON routes when set.
OBSERVER_API_TOKEN=

# Trading is dry-run by default. Live submission is controlled by this env gate,
# POLYMARKET_PRIVATE_KEY, POLY_BUILDER_CODE, and a validated recipe. The SDK
# derives CLOB API credentials from the private key.
TRADING_LIVE_ENABLED=false
SCOREBOARD_SIDE_STRATEGY_MODE=value90
POLYMARKET_PRIVATE_KEY=
POLY_BUILDER_CODE=
